# ── Output Rails ──────────────────────────────────────────────────────────────
# Run after the model generates a response, before it reaches the user.
#
# Two flows:
# 1. LlamaGuard checks the model's response for harmful content
# 2. Sensitive data check catches credentials, restricted content, PII
#    that tool results injected into the response
#
# Phase 3 Round 2 finding: check_sensitive_data is present but catches
# content AFTER the model has already processed the tool result.
# The model has already seen the credential / confidential doc.
# Output filtering is reactive — it does not prevent the action.
#
# Phase 4 bridge: this rail does NOT sanitize tool results before the model
# sees them. A poisoned KB document passes through get_article → model context
# before output filtering runs. Sanitization at retrieval time is the gap.

define flow llama guard check output
  $is_safe = execute llama_guard_check(text=$bot_message, role="assistant")
  if not $is_safe
    bot inform cannot help
    stop

define flow check sensitive data output
  $has_sensitive = execute check_sensitive_data(text=$bot_message)
  if $has_sensitive
    bot inform response redacted
    stop

# ── Bot responses ──────────────────────────────────────────────────────────────

define bot inform cannot help
  "I'm unable to provide that information."

define bot inform response redacted
  "My response contained information that can't be shared directly. Please contact the IT Help Desk at ext. 4357 for assistance."
